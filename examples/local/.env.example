# Copy this file to .env and fill in your values

# Required: Your server's private key for identity
SERVER_PRIVATE_KEY=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456

# Required: The HTTPS URL where your server will be accessible
HOSTING_URL=https://your-domain.com/

# Note: This example uses SQLite with file path './data.db'
# No database configuration needed - SQLite file is created automatically

# Optional: MongoDB connection string
MONGO_URL=root:example@mongodb://localhost:27019/overlay

EVENT_STORAGE="sqlite://./data.db"
BEEF_STORAGE="sqlite://./data.db"
